# Copy to .env (which is git-ignored) and fill in. Nothing here is needed for the default offline run.

# --- Only needed for `--publish` (Google Sheets) ---------------------------------------------
# Path to a Google service-account JSON key. Share the target sheet with that account's e-mail (Editor).
# Use a dedicated account for this project, not one that has access to anything else.
GOOGLE_CREDENTIALS_PATH=service-account.json
# The id in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# --- The run ----------------------------------------------------------------------------------
# The day the run pretends to happen (Sakila's data ends in August 2005). Default 2005-08-24.
# AS_OF_DATE=2005-08-24
# daily = like-for-like month-to-date windows; first-of-month = the five whole months before the as-of month
# RUN_MODE=daily
# split = per-store month queries run as two parts and are merged; cte = one query each
# QUERY_MODE=split

# --- Optional ---------------------------------------------------------------------------------
# SAKILA_DB_PATH=sqlite-sakila.db
# WORKBOOK_PATH=output/workbook/workbook.json
# OUTPUT_DIR=output
# CACHE_DIR=.query_cache
# MAX_WORKERS=5
# HEARTBEAT_SECONDS=120
# Sheets retries: how many attempts, seconds between attempts, and which errors are retried (all | transient)
# SHEETS_RETRIES=10
# SHEETS_RETRY_DELAY=10
# SHEETS_RETRY_MODE=all
